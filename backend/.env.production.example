# TradePilot Production Environment Configuration
ENVIRONMENT=production
DEBUG=false
HOST=127.0.0.1
PORT=8000
SECRET_KEY=tradepilot-production-secret-key-change-this-in-prod-env

# Security & CORS (Comma-separated allowed origin URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Market Data & Feed Settings
MARKET_DATA_PROVIDER=NSE_LIVE
MARKET_DATA_MODE=live

# Optional Real-Time Sub-Second Broker API Tokens (Zerodha Kite / Upstox / Angel One / Dhan)
# ZERODHA_KITE_API_KEY=your_api_key_here
# ZERODHA_KITE_ACCESS_TOKEN=your_access_token_here
# UPSTOX_API_KEY=your_upstox_key_here
# ANGEL_ONE_API_KEY=your_angel_key_here
# DHAN_CLIENT_ID=your_dhan_client_id_here

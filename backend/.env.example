# ============================================================
# TradePilot — Environment Configuration Template (.env.example)
# ============================================================

# App Core Settings
APP_NAME=TradePilot — AI-Powered NSE/BSE Trading System
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173
STARTING_CAPITAL=500000

# ============================================================
# ENVIRONMENT FLAG
# Options:
#   production   — Live mode (STRICT: blocks all paper/mock/demo providers)
#   development  — Development mode (allows local paper testing)
# ============================================================
ENVIRONMENT=development

# ============================================================
# MARKET DATA PROVIDER SELECTION
# Options:
#   NSE_LIVE       — Real data from NSE/BSE via Yahoo Finance (free, ~15-20 min delay)
#   BROKER_API     — Sub-second real-time tick feed via licensed Indian Broker API
#   BSE_LIVE       — BSE / SENSEX data stream
# ============================================================
MARKET_DATA_PROVIDER=NSE_LIVE
MARKET_DATA_MODE=live

# ============================================================
# BROKER API CREDENTIALS (for sub-second real-time tick feed)
# Fill in your authorized broker credentials and set
# MARKET_DATA_PROVIDER=BROKER_API to activate.
# ============================================================

# Generic Broker Fallback
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=

# Zerodha Kite Connect (https://kite.trade/)
# Requires: pip install kiteconnect
ZERODHA_KITE_API_KEY=
ZERODHA_KITE_API_SECRET=
ZERODHA_KITE_ACCESS_TOKEN=

# Upstox API v2 (https://upstox.com/developer/)
# Requires: pip install upstox-python-sdk
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# Angel One SmartAPI (https://smartapi.angelbroking.com/)
# Requires: pip install smartapi-python
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Dhan HQ (https://dhanhq.co/docs/)
# Requires: pip install dhanhq
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ============================================================
# INFRASTRUCTURE
# ============================================================
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://localhost/tradepilot
JWT_SECRET=change_me_with_a_secure_random_key_in_production

# ============================================================
# DATA STALENESS & HEALTH THRESHOLDS
# ============================================================
# Seconds before an un-updated quote is marked STALE
QUOTE_STALE_SECONDS=120

# Seconds of feed silence before feed is marked DISCONNECTED
FEED_DISCONNECT_SECONDS=300

# Background streaming interval in seconds
STREAM_INTERVAL_SECONDS=3.0

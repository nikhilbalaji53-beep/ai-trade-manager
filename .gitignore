# ==========================================
# TradePilot — Root .gitignore Configuration
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Python virtual environment
venv/
env/
ENV/
.venv/
backend/venv/
backend/env/
backend/.venv/

# Pytest / Coverage / Cache
.pytest_cache/
.coverage
htmlcov/
.cache

# Node / Frontend dependencies & build artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/

# Local Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
!.env.example
!.env.production.example

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Log files
*.log
logs/
backend/*.log

# AI Antigravity Brain Scratch / system generated (keep structure)
scratch/
.system_generated/
